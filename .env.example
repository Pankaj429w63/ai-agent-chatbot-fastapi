# ============================================
# AI Agent Chatbot - Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit your real .env file to GitHub.
# ============================================

# OpenAI API Key (optional - for OpenAI provider)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq API Key (optional - for Groq provider)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Tavily Search API Key (optional - only needed if you enable web search)
# Get one at: https://tavily.com/
TAVILY_API_KEY=

# Backend API base URL (optional - for Streamlit frontend override)
# BACKEND_API_URL=http://127.0.0.1:8000
